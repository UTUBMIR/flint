{
    "name": "flint",
    "version": "0.0.1",
    "description": "Powerful TypeScript game engine.",
    "keywords": [
        "engine",
        "TypeScript",
        "ts",
        "runtime",
        "editor"
    ],
    "homepage": "https://github.com/UTUBMIR/flint#readme",
    "bugs": {
        "url": "https://github.com/UTUBMIR/flint/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/UTUBMIR/flint.git"
    },
    "license": "MIT",
    "author": "UTUBMIR",
    "type": "module",
    "main": "main.js",
    "scripts": {
        "build:libs": "npx esbuild node_modules/planck-js/dist/planck.mjs --bundle --format=esm --outfile=src/flint/public/libs/planck.js --platform=browser --target=es2022 && rollup -c",
        "build": "concurrently \"npm run build:js\" \"npm run build:types && node type-generator.js\"",
        "build:dev": "esbuild src/main.ts --bundle --outfile=dist/main.js --target=es2022 --platform=browser --minify --sourcemap --loader:.png=dataurl --watch",
        "build:js": "esbuild src/main.ts --bundle --outfile=dist/main.js --target=es2022 --platform=browser --minify --sourcemap --loader:.png=dataurl",
        "build:types": "tsc -p tsconfig.json --emitDeclarationOnly"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@shoelace-style/shoelace": "^2.20.1",
        "@types/wicg-file-system-access": "^2023.10.7",
        "concurrently": "^9.2.1",
        "esbuild": "^0.27.1",
        "esbuild-wasm": "^0.27.0",
        "eslint": "^9.39.1",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^16.5.0",
        "planck-js": "^1.3.0",
        "rollup": "^4.55.1",
        "rollup-plugin-dts": "^6.3.0",
        "rollup-plugin-esbuild": "^6.2.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.4"
    },
    "dependencies": {
        "golden-layout": "^2.6.0"
    }
}
